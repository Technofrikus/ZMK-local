#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L    &kp SEMI
                &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA &kp DOT  &kp SLASH
                &kp LCTRL &kp LALT &kp LGUI &mo 1    &kp ENTER       &kp SPACE  &mo 2    &kp RALT &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp N1   &kp N2   &kp N3   &kp N4   &kp N5   &kp N6   &kp N7   &kp N8   &kp N9   &kp N0
                &kp TAB  &none    &none    &none    &none    &kp LEFT &kp DOWN &kp UP   &kp RIGHT &kp DEL
                &kp LSHFT &none    &none    &none    &none    &none    &none    &none    &none    &kp RSHFT
                &trans   &trans   &trans   &trans   &trans             &trans   &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
                &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &kp F6   &kp F7   &kp F8   &kp F9   &kp F10
                &kp F11  &kp F12  &none    &none    &none    &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
                &none    &none    &none    &none    &none    &studio_unlock &none    &none    &none    &none
                &trans   &trans   &trans   &trans   &trans            &trans   &trans   &trans   &trans
            >;
        };
    };
};
