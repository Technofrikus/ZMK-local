#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BAS_L 0
#define BAS_CM_L 1
#define SYM_L 2
#define NAV_L 3
#define NUM_L 4
#define CFG_L 5
#define BLE_L 6

// repeating space/backspace
&lt { quick-tap-ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";

        combo_slash {
            timeout-ms = <50>;
            key-positions = <0 10>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp SLASH>;
            };
        combo_lBracket {
            timeout-ms = <50>;
            key-positions = <1 11>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp LEFT_BRACKET>;
            };
        combo_lBrace {
            timeout-ms = <50>;
            key-positions = <2 12>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp LEFT_BRACE>;
            };
        combo_lParanthesis {
            timeout-ms = <50>;
            key-positions = <3 13>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp LEFT_PARENTHESIS>;
            };
        combo_equal {
            timeout-ms = <50>;
            key-positions = <4 14>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp EQUAL>;
            };

        combo_asterix {
            timeout-ms = <50>;
            key-positions = <5 15>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp ASTERISK>;
            };

        combo_rParanthesis {
            timeout-ms = <50>;
            key-positions = <6 16>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            };
        combo_rBrace {
            timeout-ms = <50>;
            key-positions = <7 17>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp RIGHT_BRACE>;
            };
        combo_rBracket {
            timeout-ms = <50>;
            key-positions = <8 18>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp RIGHT_BRACKET>;
            };
        combo_bSlash {
            timeout-ms = <50>;
            key-positions = <9 19>;
            layers = <BAS_L BAS_CM_L>;
            bindings = <&kp BACKSLASH>;
            };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
            };
	     combo_backspace {
	            timeout-ms = <50>;
	            key-positions = <16 17>;
	            bindings = <&kp BACKSPACE>;
	            };
        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESCAPE>;
            };

        combo_cfgLayer {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&mo CFG_L>;
            };

        combo_bleLayer {
            timeout-ms = <50>;
            key-positions = <30 31>;
            bindings = <&mo BLE_L>;
            };

        combo_capsWord {
            timeout-ms = <50>;
            key-positions = <22 27>;
            bindings = <&caps_word>;
            };
			
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            display-name = "homerow mods";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };
    
// COMBOS (Auszug): Q+W=ESC, W+E=TAB, I+O=BKSP, C+,=CAPSWORD, innen Daumen=CFG, links Daumen=BLE

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
// Base QWERTY
// [ Q ][ W ][ E ][ R ][ T ]   [ Y ][ U ][ I ][ O ][ P ]
// [As ][Sc ][Da ][Fg ][ G ]   [ H ][Jg ][Ka ][Lc ][.S ]
// [Zs ][ X ][ C ][ V ][ B ]   [ N ][ M ][ , ][ . ][;S ]
//           [ Nav ][Sym/Bsp]   [Num/Spc][Cmd/Ent]
            bindings = <
                &kp Q       &kp W       &kp E       &kp R       &kp T                   &kp Y       &kp U       &kp I       &kp O       &kp P
                &hm LSHFT A &hm LCTRL S  &hm LALT D  &hm LGUI F &kp G                   &mt RG(H) H       &hm RGUI J &hm RALT K  &hm RCTRL L  &lt NAV_L DOT
                &hm LSHFT Z       &kp X       &kp C       &kp V       &kp B             &kp N       &kp M       &kp COMMA   &kp DOT     &hm RSHIFT SEMI
                                          &mo NAV_L      &lt SYM_L BSPC                        &lt NUM_L SPACE   &lt LGUI RET 
            >;
        };
    
        colemak_layer {
            display-name = "Base Colemak";
// Colemak
// [ Q ][ W ][ F ][ P ][ G ]   [ J ][ L ][ U ][ Y ][ ' ]
// [As ][Rw ][Sa ][Tc ][ D ]   [ H ][Nc ][Ea ][Iw ][Os ]
// [ Z ][ X ][ C ][ V ][ B ]   [ K ][ M ][ , ][ . ][ ; ]
//         [Num/Spc][ Nav ]     [ Sym ][  Enter ]
            bindings = <
                &kp Q       &kp W       &kp F       &kp P       &kp G                   &kp J       &kp L       &kp U       &kp Y       &kp QUOT
                &hm LSHFT A &hm LGUI R  &hm LALT S  &hm LCTRL T &kp D                   &kp H       &hm RCTRL N &hm RALT E  &hm RGUI I  &hm RSHFT O
                &kp Z       &kp X       &kp C       &kp V       &kp B                   &kp K       &kp M       &kp COMMA   &kp DOT     &kp SEMI
                                          &lt NUM_L SPACE  &mo NAV_L                  &mo SYM_L   &kp RET 
            >;
        };

        sym_layer {
            display-name = "Symbol";
// Symbol
// [ ` ][ ^ ][ @ ][ $ ][ ~ ]   [ _ ][ ü ][ _ ][ ö ][ _ ]
// [ ä ][ ß ][ + ][ ! ][ # ]   [PgU][ _ ][ ? ][ ( ][ _ ]
// [ | ][ ? ][ - ][ % ][ _ ]   [PgD][ _ ][ _ ][ _ ][ _ ]
//                 [ _ ][ _ ]   [ _ ][ _ ]
            bindings = <
                &kp GRAVE   &kp CARET   &kp AT      &kp DOLLAR  &kp TILDE               &none       &kp LBKT   &none       &kp SEMI    &none
                &kp SQT    &kp MINUS    &kp PLUS    &kp EXCL   &kp HASH                &kp PG_UP    &kp UNDER  &kp ASTRK    &kp LPAR    &none
                &kp PIPE    &kp QMARK   &kp MINUS   &kp PERCENT &none                   &kp PG_DN   &none      &none       &none       &none
                                                    &none       &none                   &none       &none
            >;
        };
        
		
		
        nav_layer {
            display-name = "Navigation";
// Navigation
// [   ][   ][   ][   ][   ]   [   ][PgD][ Up][PgU][Del]
// [Sh ][Gui][Alt][Ctl][   ]   [Home][Left][Dwn][Rgt][End]
// [   ][   ][   ][   ][   ]   [   ][Prev][Play][Stop][Next]
//                 [ _ ][ _ ]   [ _ ][ _ ]
            bindings = <
                &none       &none       &none       &none       &none                   &none       &kp PG_UP   &kp UP      &kp PG_DN   &kp DEL
                &kp LSHFT   &kp LGUI    &kp LALT    &kp LCTRL   &none                   &kp HOME    &kp LEFT    &kp DOWN    &kp RIGHT   &kp END
                &none       &none       &none       &none       &none                   &none       &none       &none       &none       &none
                                                    &none       &none                   &none       &none
            >;
        };

        num_layer {
            display-name = "Numbers and F-Keys";
// Numbers / F-Keys
// [   ][ F9][F10][F11][F12]   [ + ][ 7 ][ 8 ][ 9 ][ / ]
// [   ][ F5][ F6][ F7][ F8]   [ - ][ 4 ][ 5 ][ 6 ][ . ]
// [   ][ F1][ F2][ F3][ F4]   [ 0 ][ 1 ][ 2 ][ 3 ][ * ]
//                 [ _ ][ _ ]   [  = ][ Enter ]
            bindings = <
                &none       &kp F9      &kp F10     &kp F11     &kp F12                 &kp KP_PLUS &kp KP_N7   &kp KP_N8   &kp KP_N9   &kp KP_SLASH 
                &none       &kp F5      &kp F6      &kp F7      &kp F8                  &kp KP_MINUS &kp KP_N4   &kp KP_N5   &kp KP_N6   &kp KP_DOT
                &none       &kp F1      &kp F2      &kp F3      &kp F4                  &kp KP_N0 &kp KP_N1  &kp KP_N2   &kp KP_N3   &kp KP_MULTIPLY
                                                    &none       &none                   &kp KP_EQUAL &kp KP_ENTER
            >;
        };
        
        cfg_layer {
            display-name = "Configuration";
// Config
// [ C ][   ][ toBAS ][ toBAS_CM ][PSCRN]   [   ][   ][   ][   ][   ]
// [   ][   ][   ][   ][   ]                [   ][   ][   ][   ][   ]
// [NumLK][  ][   ][   ][   ]               [   ][   ][   ][   ][   ]
//                      [ _ ][ _ ]           [ _ ][ _ ]
            bindings = <
                &kp C       &none       &to BAS_L    &to BAS_CM_L  &kp PSCRN               &none       &none       &none       &none       &none
                &none       &none       &none        &none         &none                   &none       &none       &none       &none       &none
                &kp KP_NUM  &none       &none        &none         &none                   &none       &none       &none       &none       &none
                                                     &none         &none                   &none       &none
            >;
        };
        
        ble_layer {
            display-name = "BLE stuff";
// BLE / USB / Unlock
// [   ][   ][ SysR ][   ][Boot]   [USB][BLE][   ][   ][BTCLR]
// [   ][Unlock][   ][   ][   ]    [   ][   ][   ][   ][   ]
// [   ][   ][   ][   ][   ]       [BT0][BT1][BT2][BT3][BT4]
//                 [ _ ][ _ ]       [ _ ][ _ ]
            bindings = <
                &kp B       &none       &sys_reset  &none       &bootloader         &out OUT_USB &out OUT_BLE &none        &none        &bt BT_CLR
                &none       &studio_unlock       &none       &none       &none               &none        &none        &none        &none        &none
                &none       &none       &none       &none       &none               &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                                                    &none       &none               &none       &none
            >;
        };
    };
};


