if BOARD_TIPPER_TF

config BOARD
	default "Tipper TF"

config ZMK_KEYBOARD_NAME
	default "Tipper TF"

config HAS_NRFX
	default y

if USB_DEVICE_STACK

config USB_NRFX
	default y

endif # USB_DEVICE_STACK

config BT_CTLR
	default BT

config ZMK_BLE
	default y

config ZMK_USB
	default y

config ZMK_BATTERY_VOLTAGE_DIVIDER
	default y

config ZMK_DISPLAY
	select LV_USE_CONT
	select LV_USE_LABEL
	select LV_USE_IMAGE
	select LV_USE_CANVAS
	select LV_FONT_MONTSERRAT_26

choice ZMK_DISPLAY_STATUS_SCREEN
	default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

if ZMK_DISPLAY

config SPI
	default y

config JD79653
	default y

config ZMK_DISPLAY_BLANK_ON_IDLE
	default n

config HEAP_MEM_POOL_SIZE
	default 1024

config LV_Z_MEM_POOL_SIZE
	default 4096

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
	default 100

config LV_DPI_DEF
	default 184

config LV_Z_BITS_PER_PIXEL
	default 1

choice LV_COLOR_DEPTH
	default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

menuconfig CUSTOM_WIDGET_BATTERY_STATUS
	bool "custom battery status widget"

config RETAINED_MEM
	default y

config RETENTION
	default y

config RETENTION_BOOT_MODE
	default y

# Explicitly set bootloader type for Adafruit nRF52 bootloader
# This ensures the correct magic value (0x57) is used
choice ZMK_BOOTMODE_MAGIC_VALUE_BOOTLOADER_TYPE
	default ZMK_BOOTMODE_MAGIC_VALUE_BOOTLOADER_TYPE_ADAFRUIT_NRF52

endchoice

endif # BOARD_TIPPER_TF
