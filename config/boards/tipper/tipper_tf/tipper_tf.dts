/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <common/nordic/nrf52840_uf2_boot_mode.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include "tipper_tf-layouts.dtsi"

/ {
	model = "Tipper TF";
	compatible = "tipper,tf";

	chosen {
		zephyr,code-partition = &code_partition;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zmk,kscan = &kscan0;
		zmk,physical-layout = &tipper_tf_physical_layout;
		zmk,studio-rpc-uart = &studio_rpc_usb_uart;
		zephyr,display = &display;
		/* Boot mode is set by nrf52840_uf2_boot_mode.dtsi */
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		rows = <7>;
		columns = <5>;
		map = <
		RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) 		RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
		RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) 		RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
		RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4)	        RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
		                        RC(6,3) RC(6,2) 		RC(6,1) RC(6,0)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		label = "KSCAN";
        
		debounce-period = <6>;

		diode-direction = "row2col";
		col-gpios
			= <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 26 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			, <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
			;
		row-gpios
			= <&gpio0 13 GPIO_ACTIVE_HIGH>
			, <&gpio0 15 GPIO_ACTIVE_HIGH>
			, <&gpio0 20 GPIO_ACTIVE_HIGH>
			, <&gpio0 12 GPIO_ACTIVE_HIGH>
			, <&gpio1  9 GPIO_ACTIVE_HIGH>
			, <&gpio0  8 GPIO_ACTIVE_HIGH>
			, <&gpio1  0 GPIO_ACTIVE_HIGH>
			;
	};

	vbatt {
		compatible = "zmk,battery-voltage-divider";
		label = "BATTERY";
		io-channels = <&adc 7>;
		output-ohms = <2000000>;
		full-ohms = <(2000000 + 820000)>;
	};
};

&tipper_tf_physical_layout {
	transform = <&default_transform>;
	kscan = <&kscan0>;
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&adc {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

zephyr_udc0: &usbd {
	status = "okay";
	studio_rpc_usb_uart: studio_rpc_usb_uart {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&gpregret1 {
	status = "okay";
};

&pinctrl {
	spi0_default: spi0_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 9)>,
				<NRF_PSEL(SPIM_MOSI, 0, 10)>,
				<NRF_PSEL(SPIM_MISO, 0, 5)>;
		};
	};

	spi0_sleep: spi0_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 9)>,
				<NRF_PSEL(SPIM_MOSI, 0, 10)>,
				<NRF_PSEL(SPIM_MISO, 0, 5)>;
			low-power-enable;
		};
	};
};

/* Display SPI */
&spi0 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-1 = <&spi0_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;

	display: gdew0154m09@0 {
		compatible = "gooddisplay,gdew0154m09";
		label = "DISPLAY";
		reg = <0>;
		spi-max-frequency = <4000000>;
		width = <200>;
		height = <200>;
		dc-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;
		reset-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		status = "okay";
	};
};

&flash0 {
	/*
	 * For more information, see:
	 * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
	 */
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		sd_partition: partition@0 {
			label = "mbr";
			reg = <0x00000000 0x00001000>;
		};
		code_partition: partition@1000 {
			label = "code_partition";
			reg = <0x00001000 0x000d3000>;
		};

		storage_partition: partition@d4000 {
			label = "storage";
			reg = <0x000d4000 0x00020000>;
		};

		boot_partition: partition@f4000 {
			label = "adafruit_boot";
			reg = <0x000f4000 0x0000c000>;
		};
	};
};
